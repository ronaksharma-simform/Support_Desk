# SupportDesk API configuration.
# Copy this file to `.env` in the server/ directory to override defaults.
# Defaults match `docker compose up db` at the repository root.

PORT=4000
DATABASE_URL=postgres://supportdesk:supportdesk@localhost:5432/supportdesk
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
